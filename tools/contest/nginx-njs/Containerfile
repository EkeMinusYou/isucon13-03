FROM ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential ca-certificates patch libpcre3-dev libssl-dev zlib1g-dev libxml2-dev libxslt1-dev nginx-core python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY nginx-1.18.0.tar.gz njs-0.8.9.tar.gz ./
COPY nginx-1.18-compat.patch ./
RUN printf '%s\n' \
    '4c373e7ab5bf91d34a4f11a0c9496561061ba5eee6020db272a17a7228d35f99  nginx-1.18.0.tar.gz' \
    '918accac7ec252baac1146e49fdc0f5c101c66ef3b9ceba7ce1b59be704acebf  njs-0.8.9.tar.gz' | sha256sum -c - \
    && tar xzf nginx-1.18.0.tar.gz && tar xzf njs-0.8.9.tar.gz \
    && cd njs-0.8.9 && patch -p1 < /build/nginx-1.18-compat.patch && cd .. \
    && cd nginx-1.18.0 \
    && ./configure --with-compat --with-debug --with-http_ssl_module --with-http_v2_module \
       --with-threads --with-pcre-jit --add-dynamic-module=../njs-0.8.9/nginx \
    && make -j4 modules \
    && printf 'load_module /build/nginx-1.18.0/objs/ngx_http_js_module.so;\nevents {}\nhttp { js_shared_dict_zone zone=test:1m; }\n' > /build/module-check.conf \
    && nginx -t -c /build/module-check.conf
