[Unit]
Description=ISUPipe DNS zone update owner
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=pdns
Group=pdns
EnvironmentFile=/etc/powerdns/isupipe-dns.env
ExecStart=/usr/local/bin/isupipe-dns-control
StateDirectory=isupipe/dns
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
