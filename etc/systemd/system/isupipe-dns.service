[Unit]
Description=ISUPipe authoritative DNS and durable registration log
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=pdns
Group=pdns
EnvironmentFile=/etc/isupipe-dns/isupipe-dns.env
ExecStart=/usr/local/bin/isupipe-dns-control
StateDirectory=isupipe/dns
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
