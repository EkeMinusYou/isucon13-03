[Unit]
Description=isupipe icon read replica
After=network-online.target
Wants=network-online.target

[Service]
User=isucon
Group=isucon
EnvironmentFile=/home/isucon/env.sh
EnvironmentFile=/home/isucon/topology.env
EnvironmentFile=/home/isucon/icon-read.env
Environment=ISUPIPE_MODE=icon-read
RuntimeDirectory=isupipe-icons
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/isupipe-icon-read
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
